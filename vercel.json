{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/b/:code/card.png",
      "destination": "/api/bam?c=:code&img=1"
    },
    {
      "source": "/b/:code",
      "destination": "/api/bam?c=:code"
    }
  ],
  "crons": [
    {
      "path": "/api/archive",
      "schedule": "0 9 * * 2"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
